# GitSomething publisher configuration. Users only sign in with GitHub.
# Register your own GitHub OAuth App and enable Device Flow:
# https://github.com/settings/developers
# Copy to .env.local in the project root and set this once before building.
# Rust reads ONLY this public setting; other .env secrets are not loaded.
# This public Client ID is embedded in native builds; it is not a client secret.
GITSOMETHING_GITHUB_CLIENT_ID=
