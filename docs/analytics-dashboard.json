      "id": 6648076,
      "shortId": "Z2Wi44BW",
      "name": "GitSomething · Daily active users",
      "description": "Unique participating GitSomething identities with any usage event each day. Anonymous installations and opted-in GitHub profiles; incomplete coverage because sharing is optional.",
      "query": {
        "kind": "InsightVizNode",
        "source": {
          "kind": "TrendsQuery",
          "interval": "day",
          "dateRange": {
            "date_from": "-30d"
          },
          "properties": [
            {
              "key": "app_name",
              "type": "event",
              "operator": "exact",
              "value": "GitSomething"
            }
          ],
          "filterTestAccounts": false,
          "series": [
            {
              "kind": "EventsNode",
              "name": "GitSomething usage",
              "math": "dau"
            }
          ],
          "trendsFilter": {
            "display": "ActionsLineGraph"
          }
        }
      }
    },
